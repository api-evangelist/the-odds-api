      "item": [
        {
          "id": "53dc9a84-edb9-4fce-9a74-9d664a55d406",
          "name": "Get Sport Scores",
          "request": {
            "name": "Get Sport Scores",
            "description": {
              "content": "Returns live and recent scores for a given sport. Quota: 1 credit for live scores only, 2 credits when using the daysFrom parameter. Live scores refresh approximately every 30 seconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v4",
                "sports",
                ":sport",
                "scores"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "(Required) Your API key."
                },
                {
                  "disabled": false,
                  "key": "daysFrom",
                  "value": "<integer>",
                  "description": "Include completed games from this many days ago (1-3). Adding this increases cost to 2 credits."
                },
                {
                  "disabled": false,
                  "key": "dateFormat",
                  "value": "iso",
                  "description": "Date format. Values: iso (default), unix."
                },
                {
                  "disabled": false,
                  "key": "eventIds",
                  "value": "<string>",
                  "description": "Comma-separated event IDs to filter results."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sport",
                  "description": "(Required) Sport key from /v4/sports."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
